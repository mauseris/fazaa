# انسخ هذا الملف باسم .env وعبّي القيم الحقيقية
# cp .env.example .env

# ============================================================================
#  الخيار الموصى به (الرسمي) — البوابة المركزية الإلزامية (LiteLLM/OpenRouter)
# ============================================================================
# بحسب الحقيبة التعليمية: لا يُسلَّم أي مشارك مفتاحاً مباشراً للنماذج.
# اطلب من فريق البرنامج عنوان البوابة (base_url) ومفتاحك الافتراضي (Virtual Key).
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
MODEL_NAME=

# اسم موديل الـ embeddings عبر نفس البوابة (لبناء فهرس RAG حقيقي بتمثيلات متجهية).
# إذا كانت بوابتكم لا تدعم /embeddings، اتركه فارغاً — الوكيل يرجع تلقائياً لبحث
# TF-IDF محلي (لا يحتاج اتصال خارجي) دون أي كسر بالتشغيل.
EMBED_MODEL_NAME=text-embedding-3-small

# ============================================================================
#  خيار مؤقت للتطوير المحلي فقط (قبل استلام مفتاح البوابة الرسمي)
# ============================================================================
# اتصال مباشر بمفتاحك الشخصي من https://console.anthropic.com/settings/keys
# غير مطابق لمتطلبات الحوكمة الرسمية — لا تسلّم به للتحكيم، فقط للتجربة أثناء البناء.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-sonnet-5

# منفذ تشغيل السيرفر محلياً
PORT=3000
