# انسخ هذا الملف باسم .env وعبّي القيم الحقيقية
# cp .env.example .env

# ============================================================================
#  الخيار الموصى به (الرسمي) — البوابة المركزية الإلزامية (LiteLLM/OpenRouter)
# ============================================================================
# بحسب الحقيبة التعليمية: لا يُسلَّم أي مشارك مفتاحاً مباشراً للنماذج.
# اطلب من فريق البرنامج عنوان البوابة (base_url) ومفتاحك الافتراضي (Virtual Key).
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
MODEL_NAME=

# اسم موديل الـ embeddings عبر نفس البوابة (لبناء فهرس RAG حقيقي بتمثيلات متجهية).
# إذا كانت بوابتكم لا تدعم /embeddings، اتركه فارغاً — الوكيل يرجع تلقائياً لبحث
# TF-IDF محلي (لا يحتاج اتصال خارجي) دون أي كسر بالتشغيل.
EMBED_MODEL_NAME=text-embedding-3-small

# ============================================================================
#  خيار مؤقت للتطوير المحلي فقط (قبل استلام مفتاح البوابة الرسمي)
# ============================================================================
# اتصال مباشر بمفتاحك الشخصي من https://console.anthropic.com/settings/keys
# غير مطابق لمتطلبات الحوكمة الرسمية — لا تسلّم به للتحكيم، فقط للتجربة أثناء البناء.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-sonnet-5

# ============================================================================
#  خيار مؤقت آخر للتطوير المحلي/التعليمي فقط: Hugging Face Inference Providers
# ============================================================================
# يُستخدم فقط إذا كان GATEWAY_* و ANTHROPIC_API_KEY أعلاه فارغين. غير مطابق لمتطلبات
# الحوكمة الرسمية — لا تسلّم به للتحكيم، فقط للتجربة/التعلّم أثناء البناء.
#
# احصل على التوكن من: https://huggingface.co/settings/tokens
# (أنشئ توكن من نوع fine-grained بصلاحية "Make calls to Inference Providers")
#
# ⚠️ ملاحظة مهمة عن النماذج المقيّدة (gated models): بعض النماذج مثل عائلة Llama تتطلب
# منك طلب الوصول والموافقة عليه أولاً من صفحة النموذج على huggingface.co وأنت مسجّل
# دخول بنفس الحساب صاحب هذا التوكن — وإلا سترجع كل الاستدعاءات خطأ 403 Forbidden.
HF_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ============================================================================
#  خيار اختياري مستقل: Google Places API — لميزة "المنافسون والموقع" فقط
# ============================================================================
# لا علاقة له بمزوّد المحادثة أعلاه. إذا تُرك فارغاً، تستمر الميزة بعملها بكتالوج
# تجريبي محلي (server/assistantData.js) كما هي اليوم — بدون أي كسر بالتشغيل.
# إذا ضُبط، يستبدل الكتالوج التجريبي بمنافسين ووكالات عقارية حقيقية قريبة من
# مدينة المستخدم عبر Google Places Nearby Search.
#
# احصل على المفتاح من: https://console.cloud.google.com
# فعّل Places API، وقيّد المفتاح بـ API restrictions (Places API فقط) — هذا
# مفتاح خادم (server-side) ولا يُرسل للمتصفح إطلاقاً، فلا يحتاج قيود HTTP referrer.
# ⚠️ يتطلب تفعيل الفوترة على مشروع Google Cloud (يوجد رصيد مجاني شهري).
GOOGLE_MAPS_API_KEY=

# منفذ تشغيل السيرفر محلياً
PORT=3000
